{
  "format": {
    "enabled": false
  },
  "autofix": {
    "enabled": false
  },
  "actionableWarnings": {
    "autoFix": {
      "enabled": false
    }
  },
  "rules": {
    "line-length": { "disable": ["line-length"] },
    "high-complexity": { "threshold": 30 }
  },
  "lsp": {
    "serverOverrides": {
      "rust": {
        "initializationOptions": {
          "cargo": { "features": "all" },
          "check": { "enable": false }
        }
      }
    }
  },
  "trivy": {
    "enabled": true
  }
}
