---
source: crates/webfang_mcp/tests/mcp_advertised_schema_snapshot_test.rs
expression: advertised_pretty(tool)
---
{
  "$defs": {
    "McpUrl": {
      "format": "uri",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "format": {
      "default": "jsonl",
      "description": "Export format (jsonl, vector, auto). Also accepted as `pipeline_format` and `export_format`; send exactly one of the three, never two -- they are aliases of a single field and sending two is a duplicate-field error.",
      "enum": [
        "jsonl",
        "vector",
        "auto"
      ],
      "type": "string"
    },
    "pipeline_format": {
      "description": "Export format\n\nAlso accepted as `format` and `export_format` (#1612, SD-02). All\nthree are aliases of this one field: sending two of them is a serde\nduplicate-field error, and `export_format` -- the OptionsSpec id --\nis accepted but deliberately not advertised here until the MCP compat\npolicy issue (#1614) decides whether the advertised surface keeps three\nspellings or collapses to one.",
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "description": "Optional URL to scrape before exporting. Omit to skip scraping and run the export stage on previously-saved content.",
      "type": "string"
    }
  },
  "type": "object"
}
